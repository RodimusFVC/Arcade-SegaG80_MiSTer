    <category>Action</category>

    <setname>sindbadm</setname>
    <parent>sindbadm</parent>
    <mameversion>0270</mameversion>
    <rbf>SegaG80</rbf>
    <about></about>

    <buttons names="Action,-,-,-,Coin,Start 1P,Start 2P,Pause" default="A,Select,Start,R,L"/>

    <!-- Index 1: Config -->
    <rom index="1"><part>04</part></rom>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>no</flip>


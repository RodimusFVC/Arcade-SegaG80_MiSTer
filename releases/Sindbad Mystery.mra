    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <button_names>Action</button_names>

    <switches default="FC FF">
        <dip bits="0,1"   name="Lives"        ids="3,5,4,6"/>
        <dip bits="2"     name="Cabinet"      ids="Cocktail,Upright"/>
        <dip bits="7"     name="Infinite Lives (Cheat)" ids="On,Off"/>
        <dip bits="8,11"  name="Coin A"       ids="1C/2C 5/11,1C/1C 2/3,1C/1C 4/5,1C/1C 5/6,2C/1C 4/3,2C/1C 5/3,2C/3C,4C/1C,3C/1C,2C/1C,1C/6C,1C/5C,1C/4C,1C/3C,1C/2C,1C/1C"/>
        <dip bits="12,15" name="Coin B"       ids="1C/2C 5/11,1C/1C 2/3,1C/1C 4/5,1C/1C 5/6,2C/1C 4/3,2C/1C 5/3,2C/3C,4C/1C,3C/1C,2C/1C,1C/6C,1C/5C,1C/4C,1C/3C,1C/2C,1C/1C"/>
    </switches>

